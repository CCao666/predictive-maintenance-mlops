# Development-only defaults. Replace these values outside a local demo.
POSTGRES_DB=maintenance
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=maintenance
MLFLOW_DB=mlflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MLFLOW_BUCKET=mlflow
MLFLOW_PORT=5050

# Images published by GitHub Actions. Use a sha-* tag for an immutable deploy.
API_IMAGE=ghcr.io/ccao666/predictive-maintenance-api
MLFLOW_IMAGE=ghcr.io/ccao666/predictive-maintenance-mlflow
IMAGE_TAG=main
DEPLOY_WAIT_TIMEOUT=180
